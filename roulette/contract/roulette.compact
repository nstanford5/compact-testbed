// provably fair version of the casino game roulette
// "the house" can prove that it revealed the number
// and that number did not change based on the users bet
//
// Bets are placed by sending a shielded "roulette chip" coin (minted by
// chips.compact) to the contract. The bet *type* and *value* (e.g. RED,
// number 10) are public, but the *amount of chips* lives inside the zswap
// UTXO state — visible only as a struct field on the contract ledger
// keyed by an autoincremented betId. Each player may hold many betIds at
// once.
//
// Settlement:
// - claimWin(betId) returns the chip coin to the caller at 1x payout.
// - sweepLoss(betId) lets theHouse pull a losing bet's chip into their
//   own wallet (the "house edge" — losses fund the house).
//
// The player's wallet pubkey is never stored on the ledger; the dapp
// pseudonym (Bytes<32>) is the only identifier.

pragma language_version 0.23;
import CompactStandardLibrary;

export enum BetState {
    CLOSED,
    OPEN
}

export enum Color {
    GREEN,
    RED,
    BLACK
}

export enum Thirds {
    FIRST,
    SECOND,
    THIRD
}

export enum EvenOdd {
    EVEN,
    ODD
}

export enum BigSmall {
    SMALL,
    BIG
}

// BetCategory selects which winning value is checked at claim time.
export enum BetCategory {
    NUMBER,
    COLOR,
    THIRDS,
    EVEN_ODD,
    BIG_SMALL
}

// A single bet record. The encoded `value`'s meaning depends on `category`:
// NUMBER → 0-36, COLOR → Color enum cast to Uint<8>, etc. The owner field
// is the bettor's dapp pseudonym so claimWin can authorize the caller
// without a second Map lookup.
struct BetInfo {
    category: BetCategory,
    value: Uint<8>,
    owner: Bytes<32>
}

export sealed ledger theHouse: Bytes<32>;
export sealed ledger chipColor: Bytes<32>;
export sealed ledger maxBetCount: Uint<8>;
export ledger winningNumHash: Bytes<32>;
export ledger winningNumPublic: Uint<8>;
export ledger betState: BetState;

// Bets keyed by the chip coin's nonce. A single player may have many
// concurrent bets. Settling — via claimWin or sweepLoss — removes the
// entry from both maps; absence from `bets` is the canonical "already
// settled" signal. The owner pseudonym lives inside BetInfo to avoid a
// second Map.lookup at claim time (which triggers an effects-check
// mismatch when the contract has multiple entries).
export ledger bets: Map<Bytes<32>, BetInfo>;
export ledger betCoins: Map<Bytes<32>, QualifiedShieldedCoinInfo>;

export ledger color: Color;
export ledger third: Thirds;
export ledger evenOdd: EvenOdd;
export ledger bigSmall: BigSmall;
export ledger betCount: Counter;     // total bets ever placed

// Caller-supplied secret. Each caller derives a DApp-specific pseudonymous
// identity from this secret via getDappPublicKey.
witness localSecretKey(): Bytes<32>;

constructor(setMaxBetCount: Uint<8>, _winningNum: Uint<8>, chipColorInput: Bytes<32>) {
    assert(_winningNum >= 0 && _winningNum <= 36, "Cheat Detected: theHouse: Please keep the number on the table");
    assert(chipColorInput != default<Bytes<32>>, "Chip color must be set");

    const _sk = localSecretKey();
    const admin = getDappPublicKey(_sk);
    theHouse = disclose(admin);

    chipColor = disclose(chipColorInput);
    maxBetCount = disclose(setMaxBetCount);

    winningNumHash = commitWithSk(_winningNum as Bytes<32>, _sk);
    betState = BetState.OPEN;
}

// Shared opening checks. Players may stack bets, so we no longer reject
// repeat callers — only the global table size cap applies.
circuit assertCanBet(player: Bytes<32>, coin: ShieldedCoinInfo): [] {
    assert(betState == BetState.OPEN, "Not ready to accept bets yet");
    assert(betCount < maxBetCount, "Sorry, the table is full");
    assert(player != theHouse, "theHouse cannot make bets");
    assert(disclose(coin.color) == chipColor, "Bet must be paid in roulette chips");
    assert(disclose(coin.value) > 0, "Bet must have a positive chip amount");
}

// Take in the chip coin and record the bet against the player's dapp
// pseudonym. The chip's nonce uniquely identifies the UTXO and is used
// directly as the betId — no counter read-after-write, which avoids the
// effects-check conflicts that arise when the id depends on mutated
// state. The chip's value enters the contract's shielded pool; the
// QualifiedShieldedCoinInfo handle is stored for later sendShielded by
// claimWin / sweepLoss.
circuit acceptBetCoin(coin: ShieldedCoinInfo, info: BetInfo): Bytes<32> {
    const id = coin.nonce;

    receiveShielded(coin);
    // insertCoin is a special built-in Map operation that allows storing
    // shielded coin info without disclose().
    betCoins.insertCoin(
        id,
        coin,
        right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
    );
    bets.insert(id, info);
    betCount.increment(1);
    return id;
}

export circuit betColor(coin: ShieldedCoinInfo, colorBet: Color): Bytes<32> {
    assert(colorBet == Color.RED ||
        colorBet == Color.BLACK ||
        colorBet == Color.GREEN, "Please choose a valid color");

    const _sk = localSecretKey();
    const player = getDappPublicKey(_sk);
    assertCanBet(player, coin);

    const pubPlayer = disclose(player);
    const info = BetInfo {
        category: BetCategory.COLOR,
        value: disclose(colorBet) as Uint<8>,
        owner: pubPlayer
    };
    return acceptBetCoin(disclose(coin), info);
}

export circuit betThirds(coin: ShieldedCoinInfo, thirdBet: Thirds): Bytes<32> {
    assert(
        thirdBet == Thirds.FIRST ||
        thirdBet == Thirds.SECOND ||
        thirdBet == Thirds.THIRD, "Please choose a valid third bet");

    const _sk = localSecretKey();
    const player = getDappPublicKey(_sk);
    assertCanBet(player, coin);

    const pubPlayer = disclose(player);
    const info = BetInfo {
        category: BetCategory.THIRDS,
        value: disclose(thirdBet) as Uint<8>,
        owner: pubPlayer
    };
    return acceptBetCoin(disclose(coin), info);
}

export circuit betEvenOdd(coin: ShieldedCoinInfo, betEvenOdd: EvenOdd): Bytes<32> {
    assert(
        betEvenOdd == EvenOdd.EVEN ||
        betEvenOdd == EvenOdd.ODD, "Please choose only Even or Odd"
    );

    const _sk = localSecretKey();
    const player = getDappPublicKey(_sk);
    assertCanBet(player, coin);

    const pubPlayer = disclose(player);
    const info = BetInfo {
        category: BetCategory.EVEN_ODD,
        value: disclose(betEvenOdd) as Uint<8>,
        owner: pubPlayer
    };
    return acceptBetCoin(disclose(coin), info);
}

export circuit betBigSmall(coin: ShieldedCoinInfo, betBigSmall: BigSmall): Bytes<32> {
    assert(betBigSmall == BigSmall.SMALL || betBigSmall == BigSmall.BIG, "Please choose only Big or Small");

    const _sk = localSecretKey();
    const player = getDappPublicKey(_sk);
    assertCanBet(player, coin);

    const pubPlayer = disclose(player);
    const info = BetInfo {
        category: BetCategory.BIG_SMALL,
        value: disclose(betBigSmall) as Uint<8>,
        owner: pubPlayer
    };
    return acceptBetCoin(disclose(coin), info);
}

export circuit betNumber(coin: ShieldedCoinInfo, number: Uint<8>): Bytes<32> {
    assert(number >= 0 && number <= 36, "Please keep the number on the board");

    const _sk = localSecretKey();
    const player = getDappPublicKey(_sk);
    assertCanBet(player, coin);

    const pubPlayer = disclose(player);
    const info = BetInfo {
        category: BetCategory.NUMBER,
        value: disclose(number),
        owner: pubPlayer
    };
    return acceptBetCoin(disclose(coin), info);
}

export circuit revealWinningNumber(winningNum: Uint<8>): [] {
    const _sk = localSecretKey();
    const pubKey = getDappPublicKey(_sk);
    assert(pubKey == theHouse, "Only the House can reveal the number");

    const hash = commitWithSk(winningNum as Bytes<32>, _sk);
    assert(hash == winningNumHash, "Cheat Detected: theHouse: tried to change the winning number");

    betState = BetState.CLOSED;
    winningNumPublic = disclose(winningNum);
    color = getColor(winningNumPublic);
    third = getThirds(winningNumPublic);
    evenOdd = getOdd(winningNumPublic) ? EvenOdd.EVEN : EvenOdd.ODD;
    bigSmall = (winningNumPublic <= 18) ? BigSmall.SMALL : BigSmall.BIG;
}

// Check whether a recorded bet matches the revealed result.
circuit isWinningBet(bet: BetInfo): Boolean {
    if (bet.category == BetCategory.NUMBER) {
        return bet.value == winningNumPublic;
    }
    if (bet.category == BetCategory.COLOR) {
        return bet.value == (color as Uint<8>);
    }
    if (bet.category == BetCategory.THIRDS) {
        return bet.value == (third as Uint<8>);
    }
    if (bet.category == BetCategory.EVEN_ODD) {
        return bet.value == (evenOdd as Uint<8>);
    }
    if (bet.category == BetCategory.BIG_SMALL) {
        return bet.value == (bigSmall as Uint<8>);
    }
    return false;
}

// Pay the chip coin back to the bet's owner (1x payout). The recipient is
// derived from the caller's actual ZswapCoinPublicKey via ownPublicKey() —
// that pubkey is never written to the ledger.
export circuit claimWin(betId: Bytes<32>): [] {
    assert(betState == BetState.CLOSED, "Winning number has not been revealed");

    const _sk = localSecretKey();
    const pubAddress = getDappPublicKey(_sk);
    assert(pubAddress != theHouse, "Only players can claim a win");

    const pubId = disclose(betId);
    assert(bets.member(pubId), "Unknown or already-settled bet");

    const bet = bets.lookup(pubId);
    assert(bet.owner == disclose(pubAddress), "Not your bet");
    assert(isWinningBet(bet), "You did not place a winning bet");

    const coin = betCoins.lookup(pubId);
    sendShielded(
        coin,
        left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
        coin.value as Uint<128>
    );

    bets.remove(pubId);
    betCoins.remove(pubId);
}

// theHouse sweeps a losing bet's chip into their own wallet. Only callable
// after the winning number is revealed and only against bets that did not
// win.
export circuit sweepLoss(betId: Bytes<32>): [] {
    assert(betState == BetState.CLOSED, "Winning number has not been revealed");

    const _sk = localSecretKey();
    const pubAddress = getDappPublicKey(_sk);
    assert(pubAddress == theHouse, "Only the House can sweep losses");

    const pubId = disclose(betId);
    assert(bets.member(pubId), "Unknown or already-settled bet");

    const bet = bets.lookup(pubId);
    assert(!isWinningBet(bet), "Cannot sweep a winning bet");

    const coin = betCoins.lookup(pubId);
    sendShielded(
        coin,
        left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
        coin.value as Uint<128>
    );

    bets.remove(pubId);
    betCoins.remove(pubId);
}

circuit getThirds(num: Uint<8>): Thirds {
    if(num <= 12) { return Thirds.FIRST; }
    if(num > 12 && num < 25) { return Thirds.SECOND; }
    else return Thirds.THIRD;
}

circuit getOdd(num: Uint<8>): Boolean {
    if(
        num == 1 ||
        num == 3 ||
        num == 5 ||
        num == 7 ||
        num == 9 ||
        num == 11 ||
        num == 13 ||
        num == 15 ||
        num == 17 ||
        num == 19 ||
        num == 21 ||
        num == 23 ||
        num == 25 ||
        num == 27 ||
        num == 29 ||
        num == 31 ||
        num == 33 ||
        num == 35
    ) {
        return true;
    } else {
        return false;
    }
}

circuit getColor(num: Uint<8>) : Color {
    if(num == 0){
        return Color.GREEN;
    }
    if(getOdd(num) == true) {
        return Color.RED;
    }
    else {
        return Color.BLACK;
    }
}

// hash a publicKey specific to this DApp so that users cannot be tracked
// across DApps. The _secret should be a high-entropy 32-byte value.
circuit getDappPublicKey(_secret: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "roulette:pk:"), _secret]);
}

circuit commitWithSk(_winningNum: Bytes<32>, _sk: Bytes<32>) : Bytes<32> {
    return disclose(persistentHash<Vector<2, Bytes<32>>>([_winningNum, _sk]));
}
